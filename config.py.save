_listings = {l["id"]: l for l in SAMPLE_LISTINGS}
_user_favorites = {}
_user_listings = {}
_next_id = len(SAMPLE_LISTINGS) + 1


def search_listings(filters: Dict) -> List[Dict]:
    results = []
    for listing in _listings.values():
        if not listing.get("active"):
            continue
        if filters.get("deal_type") and listing["deal_type"] != filters["deal_type"]:
            continue
        if filters.get("property_types") and listing["property_type"] not in filters["property_types"]:
            continue
        if filters.get("district") and listing["district"] != filters["district"]:
            continue
        if filters.get("city") and listing["city"] != filters["city"]:
            continue
        if filters.get("rooms_min"):
            try:
                if float(listing["rooms"].replace("+","")) < float(filters["rooms_min"].replace("+","")):
                    continue
            except (ValueError, AttributeError):
                pass
        if filters.get("rooms_max"):
            try:
                if float(listing["rooms"].replace("+","")) > float(filters["rooms_max"].replace("+","")):
                    continue
            except (ValueError, AttributeError):
                pass
        if filters.get("price_min") is not None and listing["price"] < filters["price_min"]:
            continue
        if filters.get("price_max") is not None and listing["price"] > filters["price_max"]:
            continue
        if filters.get("parking_min") is not None and listing["parking"] < filters["parking_min"]:
            continue
        if filters.get("pool") is True and not listing["pool"]:
            continue
        if filters.get("infrastructure"):
            if not set(filters["infrastructure"]).issubset(set(listing.get("infrastructure", []))):
                continue
        results.append(listing)
    return results


def get_listing(listing_id: int) -> Optional[Dict]:
    return _listings.get(listing_id)


def add_listing(listing_data: Dict) -> int:
    global _next_id
    listing_data["id"] = _next_id
    listing_data["date_added"] = datetime.now().strftime("%Y-%m-%d")
    listing_data["active"] = True
    _listings[_next_id] = listing_data
    _next_id += 1
    user_id = listing_data.get("user_id")
    if user_id:
        _user_listings.setdefault(user_id, []).append(listing_data["id"])
    return listing_data["id"]


def get_user_listings(user_id: int) -> List[Dict]:
    return [_listings[i] for i in _user_listings.get(user_id, []) if i in _listings]


def toggle_favorite(user_id: int, listing_id: int) -> bool:
    favs = _user_favorites.setdefault(user_id, [])
    if listing_id in favs:
        favs.remove(listing_id)
        return False
    favs.append(listing_id)
    return True


def get_favorites(user_id: int) -> List[Dict]:
    return [_listings[i] for i in _user_favorites.get(user_id, []) if i in _listings]


def get_all_listings(limit: int = 10) -> List[Dict]:
    return [l for l in _listings.values() if l.get("active")][:limit]nano i18n.py
